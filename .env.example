# ===== Reltime Mainnet =====
RELTIME_RPC_URL=https://mainnet.reltime.com/
RELTIME_CHAIN_ID=32323

# Deployer / signer private key (WITHOUT 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Deployed contract address (filled after deployment)
CONTRACT_ADDRESS=

# ===== API Server =====
PORT=3000
NODE_ENV=production

# JWT secret for DataIntegrityValidator authentication
JWT_SECRET=your_very_long_random_secret_here

# 32-byte AES key as 64 hex characters, used to encrypt local user wallets
WALLET_ENCRYPTION_KEY=your_64_hex_character_wallet_encryption_key_here

# Allowed origins (comma separated)
CORS_ORIGINS=https://comfortage-t34.example.com

# ===== Logging =====
LOG_LEVEL=info
